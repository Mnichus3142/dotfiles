# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #0f0d12
selected_bg = #1c181f
header_bg = #28242d

# Text colors
text = #ebe2ef
selected_text = #d3beea
header_text = #b0a8b4
inactive_text = #79737e

# GPU utilization colors (gradient from low to high)
gpu_util_low = #c8e3ff
gpu_util_med = #ffecf3
gpu_util_high = #d79ff0

# Memory usage colors
memory_low = #ddddff
memory_med = #c8c0ff
memory_high = #c5b1ff

# Temperature colors (cool to hot)
temp_cool = #c8e3ff
temp_warm = #ffecf3
temp_hot = #d79ff0

# Power usage colors
power_low = #c8e3ff
power_med = #efbeee
power_high = #d8b1e5

# Process list colors
process_normal = #ebe2ef
process_highlight = #d3beea
process_killed = #d79ff0

# Border and separator colors
border = #79737e
separator = #4b4650

# Chart and graph colors
chart_line = #fbc1df
chart_fill = #1c181f

# Status indicators
status_ok = #c8e3ff
status_warning = #ffecf3
status_error = #d79ff0
status_info = #c5b1ff
