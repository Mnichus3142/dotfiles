# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #100e08
selected_bg = #1d1910
header_bg = #2a2519

# Text colors
text = #efe4d1
selected_text = #dbc587
header_text = #b3aa98
inactive_text = #7c7565

# GPU utilization colors (gradient from low to high)
gpu_util_low = #f2e17a
gpu_util_med = #fff0cf
gpu_util_high = #eaa740

# Memory usage colors
memory_low = #e6e490
memory_med = #b3d27e
memory_high = #75cf9d

# Temperature colors (cool to hot)
temp_cool = #f2e17a
temp_warm = #fff0cf
temp_hot = #eaa740

# Power usage colors
power_low = #f2e17a
power_med = #efc87e
power_high = #e7b672

# Process list colors
process_normal = #efe4d1
process_highlight = #dbc587
process_killed = #eaa740

# Border and separator colors
border = #7c7565
separator = #4d4739

# Chart and graph colors
chart_line = #dca577
chart_fill = #1d1910

# Status indicators
status_ok = #f2e17a
status_warning = #fff0cf
status_error = #eaa740
status_info = #75cf9d
